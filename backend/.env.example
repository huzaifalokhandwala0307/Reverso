# BlackBoxRAG Backend Environment Variables Example

APP_NAME="BlackBoxRAG API"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database URL
# For local Postgres: postgresql+psycopg://blackbox:blackbox@localhost:5432/blackboxrag
# For Docker Compose: postgresql+psycopg://blackbox:blackbox@postgres:5432/blackboxrag
# For SQLite local fallback: sqlite:///./blackboxrag.db
DATABASE_URL=postgresql+psycopg://blackbox:blackbox@localhost:5432/blackboxrag
